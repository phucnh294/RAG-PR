# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# This is the single place to change LLM/embedding models, ports the backend uses, and
# tuning knobs — docker-compose.yml injects it into every container via `env_file: .env`,
# and backend/src/rag_backend/config.py loads it the same way for local (non-Docker) runs.
# Only values that genuinely differ between "on your host" and "inside the Docker network"
# (service base URLs, the postgres host/port) are set in docker-compose.yml instead — see
# the comments there.

# --- Postgres ---
POSTGRES_DB=db-ai
POSTGRES_USER=user
POSTGRES_PASSWORD=user
# Local (non-Docker) backend only — inside Docker these are overridden to postgres:5432.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433

# --- LLM provider ---
# "ollama" (default, uses the local llm-model container) or "google" (calls the
# Gemini API instead — requires GOOGLE_API_KEY).
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen2.5:0.5b-instruct
# LLM_REQUEST_TIMEOUT_SECONDS=60
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-2.0-flash

# --- Embedding model ---
EMBEDDING_MODEL_NAME=nomic-embed-text
# Per request (= per batch of EMBEDDING_BATCH_SIZE chunks), not per document.
# EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_DIMENSION=768

# --- Chunking & retrieval ---
# CHUNK_SIZE_WORDS=200
# CHUNK_OVERLAP_WORDS=20
# RETRIEVAL_TOP_K=5
# MIN_SIMILARITY_SCORE=0.7
# Hybrid search = vector search + Postgres full-text search, fused with RRF.
# HYBRID_SEARCH_ENABLED=true
# HYBRID_CANDIDATE_K=20
# RRF_K=60
# FULLTEXT_SEARCH_CONFIG=english

# --- Reranking (cross-encoder, reranker-model container) ---
# The chat UI toggle sets this per request; the default only applies to API callers
# that don't say. RERANKER_BASE_URL is set by docker-compose for the backend service.
# RERANK_ENABLED_DEFAULT=false
# RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
# RERANK_CANDIDATE_K=10
# RERANKER_REQUEST_TIMEOUT_SECONDS=15
# RERANKER_BATCH_SIZE=32

# --- Uploads & logging ---
# MAX_UPLOAD_SIZE_MB=25
# LOG_LEVEL=INFO

# --- Guardrails ---
# Layer 1 (input) and Layer 3 (output) use an LLM-as-judge call; Layer 2 (evidence) is
# always flag-only and never blocks — see rag_backend/guardrails/.
GUARDRAIL_INPUT_ENABLED=true
GUARDRAIL_OUTPUT_ENABLED=true
GUARDRAIL_EVIDENCE_ENABLED=true
GUARDRAIL_MAX_INPUT_CHARS=4000
# Judge LLM defaults to the same provider/model/base_url as the main answer LLM above;
# override here to use a cheaper/faster model for judging.
GUARDRAIL_JUDGE_PROVIDER=
GUARDRAIL_JUDGE_BASE_URL=
GUARDRAIL_JUDGE_MODEL_NAME=
GUARDRAIL_JUDGE_TIMEOUT_SECONDS=20
GUARDRAIL_EVIDENCE_HIGH_THRESHOLD=0.85
GUARDRAIL_EVIDENCE_MEDIUM_THRESHOLD=0.75
GUARDRAIL_REFUSAL_MESSAGE=I can't help with that request.

# --- Authorization ---
# Roles (lowest -> highest) and document classifications (lowest -> highest), as JSON.
# AUTH_ROLES=["user","staff","manager","admin"]
# AUTH_CLASSIFICATIONS=["public","internal","confidential","restricted"]
# Which classifications each role may READ. Each grant is applied to the
# role_classification_access table once: a grant added here later is picked up on the next
# restart, while a grant an admin revokes (PUT /auth/access or SQL) stays revoked.
# AUTH_ROLE_ACCESS={"user":["public"],"staff":["public","internal"],"manager":["public","internal","confidential"],"admin":["public","internal","confidential","restricted"]}
# Classification for uploads that name none (capped at the uploader's clearance).
# AUTH_DEFAULT_CLASSIFICATION=internal
# AUTH_DEFAULT_USER_ROLE=user
# Seeded on every startup and always forced back to role=admin (restart to recover a lost admin).
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
# Dev/test only: seeds demo_user / demo_staff / demo_manager and exposes the
# unauthenticated GET /auth/demo-users list behind the UI's "Acting as" role picker.
# Set to false once real login exists.
AUTH_DEV_MODE=true
# SEED_DOCUMENTS_CLASSIFICATION=public
